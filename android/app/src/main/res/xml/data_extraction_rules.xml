<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup, no device transfer of app data: user photographs and
     in-progress projects never leave the device via any Android platform
     backup channel either, consistent with PRIVACY.md. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
